<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PasswordBruteForcer</AssemblyName>
    <!-- Server GC gives each core its own heap, so the 11 worker threads can allocate the
         per-candidate strings without serialising on a single garbage-collector heap.
         This noticeably improves multi-threaded brute-force throughput (Task 5/8). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>